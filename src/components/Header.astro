---
import { languages, languageNames, type Lang } from '../lib/i18n';
import { translationLanguages } from '../lib/loopi';
const { lang } = Astro.props as { lang: Lang };
---
<header class="site-header">
  <a class="brand" href={`/${lang}/`} aria-label="Loopi inicio"><span class="loop">∞</span>loopi</a>
  <nav aria-label="Navegación principal">
    <a href={`/${lang}/`}>Inicio</a>
    <a href={`/${lang}/historias/`}>Historias</a>
    <a href={`/${lang}/enviar/`}>Enviar historia</a>
    <a href={`/${lang}/normas/`}>Normas</a>
  </nav>
  <div class="language-tools">
    <select id="interfaceLanguage" aria-label="Idioma de la interfaz">
      {languages.map((item) => <option value={item} selected={item === lang}>{languageNames[item]}</option>)}
    </select>
    <select id="translationLanguage" aria-label="Traducir esta página">
      <option value="">Traducir</option>
      {translationLanguages.map(([code, name]) => <option value={code}>{name}</option>)}
    </select>
  </div>
</header>
<script>
  const interfaceLanguage = document.querySelector<HTMLSelectElement>('#interfaceLanguage');
  interfaceLanguage?.addEventListener('change', () => {
    const next = interfaceLanguage.value;
    const parts = window.location.pathname.split('/');
    if (['es', 'en', 'fr'].includes(parts[1])) parts[1] = next;
    else parts.splice(1, 0, next);
    window.location.href = `${parts.join('/')}${window.location.search}${window.location.hash}`;
  });
  const translationLanguage = document.querySelector<HTMLSelectElement>('#translationLanguage');
  translationLanguage?.addEventListener('change', () => {
    if (!translationLanguage.value) return;
    window.location.href = `https://translate.google.com/translate?sl=auto&tl=${translationLanguage.value}&u=${encodeURIComponent(window.location.href)}`;
  });
</script>
<style>
  .site-header{min-height:68px;background:rgba(18,15,31,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:0 max(28px,calc((100vw - 1180px)/2));display:flex;align-items:center;gap:28px;position:sticky;top:0;z-index:10}
  .brand{font:800 26px 'Plus Jakarta Sans',sans-serif;letter-spacing:-1.7px;display:flex;align-items:center;gap:5px}.loop{width:26px;height:26px;border-radius:9px;background:linear-gradient(135deg,#957cff,#6544e5);color:#fff;font:700 27px/22px Arial;text-align:center;letter-spacing:-5px;padding-right:5px}
  nav{display:flex;align-self:stretch;gap:20px;margin-left:auto}nav a{display:flex;align-items:center;color:var(--muted);font-size:12px;font-weight:700;border-bottom:2px solid transparent}nav a:hover{color:var(--purple);border-color:var(--purple)}
  .language-tools{display:flex;gap:7px}.language-tools select{border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);padding:7px;font-size:11px;max-width:112px}
  @media(max-width:800px){.site-header{gap:15px}nav{gap:12px}.language-tools select{max-width:88px}}@media(max-width:590px){.site-header{padding:10px 16px;align-items:flex-start;flex-wrap:wrap;gap:9px}.brand{font-size:22px}nav{order:3;width:100%;height:25px;justify-content:space-between;margin:0}nav a{font-size:10px}.language-tools{margin-left:auto}.language-tools select{font-size:10px;padding:5px;width:74px}}
</style>
