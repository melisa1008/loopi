---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const copy = {
  es: { title: 'Privacidad — Loopi', eyebrow: 'Tu información', heading: 'Privacidad en Loopi', intro: 'Publicamos solo lo que apruebes y lo que la moderación considere seguro para la comunidad.', sections: [{ title: 'Qué puede aparecer públicamente', text: 'El texto aprobado, su categoría, fecha y el nombre, seudónimo o estado anónimo que elijas. Tu correo nunca se publica.' }, { title: 'Protección de identidades', text: 'Puedes solicitar que cambiemos nombres, lugares, fechas u otros detalles identificables antes de publicar una historia. Loopi puede rechazar un envío si no es posible hacerlo seguro.' }, { title: 'Envíos y comentarios', text: 'Los formularios se usan únicamente para moderar el contenido y, si dejas tu correo, responderte. No se venden datos ni se usan para publicidad.' }, { title: 'Traducción', text: 'El selector de traducción abre una herramienta externa. Revisa la política de esa herramienta antes de usarla con información sensible.' }] },
  en: { title: 'Privacy — Loopi', eyebrow: 'Your information', heading: 'Privacy at Loopi', intro: 'We publish only what you approve and what moderation considers safe for the community.', sections: [{ title: 'What may appear publicly', text: 'The approved text, its category, date, and the name, pseudonym, or anonymous status you choose. Your email is never published.' }, { title: 'Protecting identities', text: 'You may ask us to change names, places, dates, or other identifying details before a story is published. Loopi may reject a submission if it cannot be made safe.' }, { title: 'Submissions and comments', text: 'Forms are used only to moderate content and, if you leave your email, to reply to you. Data is not sold or used for advertising.' }, { title: 'Translation', text: 'The translation selector opens an external tool. Review that tool’s policy before using it with sensitive information.' }] },
  fr: { title: 'Confidentialité — Loopi', eyebrow: 'Tes informations', heading: 'Confidentialité sur Loopi', intro: 'Nous ne publions que ce que tu approuves et ce que la modération estime sûr pour la communauté.', sections: [{ title: 'Ce qui peut apparaître publiquement', text: 'Le texte approuvé, sa catégorie, sa date et le nom, pseudonyme ou statut anonyme que tu choisis. Ton e-mail n’est jamais publié.' }, { title: 'Protection des identités', text: 'Tu peux demander la modification de noms, de lieux, de dates ou d’autres détails identifiants avant la publication d’une histoire. Loopi peut refuser un envoi s’il est impossible de le rendre sûr.' }, { title: 'Envois et commentaires', text: 'Les formulaires servent uniquement à modérer le contenu et, si tu laisses ton e-mail, à te répondre. Les données ne sont ni vendues ni utilisées à des fins publicitaires.' }, { title: 'Traduction', text: 'Le sélecteur de traduction ouvre un outil externe. Consulte sa politique avant de l’utiliser avec des informations sensibles.' }] },
  pt: { title: 'Privacidade — Loopi', eyebrow: 'A tua informação', heading: 'Privacidade no Loopi', intro: 'Publicamos apenas o que aprovas e o que a moderação considera seguro para a comunidade.', sections: [{ title: 'O que pode aparecer publicamente', text: 'O texto aprovado, a sua categoria, data e o nome, pseudónimo ou estado anónimo que escolheres. O teu e-mail nunca é publicado.' }, { title: 'Proteção de identidades', text: 'Podes pedir que alteremos nomes, lugares, datas ou outros detalhes identificáveis antes de publicar uma história. O Loopi pode recusar um envio se não for possível torná-lo seguro.' }, { title: 'Envios e comentários', text: 'Os formulários são usados apenas para moderar o conteúdo e, se deixares o teu e-mail, responder-te. Os dados não são vendidos nem usados para publicidade.' }, { title: 'Tradução', text: 'O seletor de tradução abre uma ferramenta externa. Consulta a política dessa ferramenta antes de a usar com informação sensível.' }] },
  it: { title: 'Privacy — Loopi', eyebrow: 'Le tue informazioni', heading: 'Privacy su Loopi', intro: 'Pubblichiamo solo ciò che approvi e che la moderazione considera sicuro per la comunità.', sections: [{ title: 'Cosa può apparire pubblicamente', text: 'Il testo approvato, la sua categoria, la data e il nome, pseudonimo o stato anonimo che scegli. La tua e-mail non viene mai pubblicata.' }, { title: 'Protezione delle identità', text: 'Puoi chiedere di modificare nomi, luoghi, date o altri dettagli identificativi prima di pubblicare una storia. Loopi può rifiutare un invio se non è possibile renderlo sicuro.' }, { title: 'Invii e commenti', text: 'I moduli sono usati solo per moderare i contenuti e, se lasci la tua e-mail, per risponderti. I dati non vengono venduti né usati per pubblicità.' }, { title: 'Traduzione', text: 'Il selettore di traduzione apre uno strumento esterno. Consulta la sua informativa prima di usarlo con informazioni sensibili.' }] },
  de: { title: 'Datenschutz — Loopi', eyebrow: 'Deine Informationen', heading: 'Datenschutz bei Loopi', intro: 'Wir veröffentlichen nur, was du freigibst und was die Moderation für die Gemeinschaft als sicher einstuft.', sections: [{ title: 'Was öffentlich erscheinen kann', text: 'Der freigegebene Text, seine Kategorie, das Datum und der von dir gewählte Name, das Pseudonym oder der anonyme Status. Deine E-Mail-Adresse wird niemals veröffentlicht.' }, { title: 'Schutz von Identitäten', text: 'Du kannst vor der Veröffentlichung einer Geschichte um Änderungen von Namen, Orten, Daten oder anderen identifizierenden Details bitten. Loopi kann eine Einsendung ablehnen, wenn sie nicht sicher gestaltet werden kann.' }, { title: 'Einsendungen und Kommentare', text: 'Formulare werden ausschließlich zur Moderation von Inhalten und, falls du deine E-Mail hinterlässt, zur Antwort an dich verwendet. Daten werden nicht verkauft oder für Werbung genutzt.' }, { title: 'Übersetzung', text: 'Der Übersetzungswähler öffnet ein externes Werkzeug. Lies dessen Richtlinie, bevor du es mit sensiblen Informationen verwendest.' }] }
}[lang];
---
<BaseLayout lang={lang} title={copy.title} description={copy.intro}><section class="page-wrap text-page"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p class="intro">{copy.intro}</p><div class="rules">{copy.sections.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}</div></section></BaseLayout>
<style>.text-page{max-width:840px}.text-page h1{font:800 49px 'Plus Jakarta Sans';letter-spacing:-.07em;margin:8px 0}.intro{font-size:17px;color:var(--muted);max-width:700px}.rules{margin-top:35px}.rules section{padding:19px 0;border-top:1px solid var(--line)}.rules h2{font:800 21px 'Plus Jakarta Sans';letter-spacing:-.04em;margin:0}.rules p{color:var(--muted);font-size:14px;max-width:680px}</style>
