---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const copy = {
  es: { title: 'Normas de Loopi', eyebrow: 'Comunidad segura', heading: 'Normas de Loopi', intro: 'Loopi es un espacio para compartir historias con respeto. Todos los envíos y comentarios se revisan antes de ser visibles.', sections: [{ title: 'Lo que sí tiene lugar aquí', text: 'Historias personales, recuerdos, reflexiones y conversaciones respetuosas. Puedes usar tu nombre, un seudónimo o publicar de forma anónima.' }, { title: 'Lo que no publicamos', text: 'Insultos, amenazas, acoso, lenguaje de odio, publicidad, enlaces sospechosos, contenido sexual con menores o información privada de otras personas.' }, { title: 'Cuida tu privacidad', text: 'No compartas direcciones, teléfonos, contraseñas, documentos ni datos que identifiquen a otra persona. Puedes pedir que Loopi cambie nombres, lugares o detalles antes de publicar.' }, { title: 'Edad mínima', text: 'Para enviar historias o comentarios debes tener 16 años o más. Si ves algo preocupante, no interactúes: repórtalo mediante el formulario correspondiente.' }] },
  en: { title: 'Loopi Rules', eyebrow: 'A safe community', heading: 'Loopi Rules', intro: 'Loopi is a place to share stories respectfully. Every submission and comment is reviewed before it becomes visible.', sections: [{ title: 'What belongs here', text: 'Personal stories, memories, reflections, and respectful conversations. You may use your name, a pseudonym, or post anonymously.' }, { title: 'What we do not publish', text: 'Insults, threats, harassment, hate speech, advertising, suspicious links, sexual content involving minors, or another person’s private information.' }, { title: 'Protect your privacy', text: 'Do not share addresses, phone numbers, passwords, documents, or details that identify another person. You can ask Loopi to change names, places, or details before publication.' }, { title: 'Minimum age', text: 'You must be at least 16 to submit stories or comments. If you see something concerning, do not engage with it: report it through the relevant form.' }] },
  fr: { title: 'Règles de Loopi', eyebrow: 'Communauté sûre', heading: 'Règles de Loopi', intro: 'Loopi est un espace où partager des histoires avec respect. Chaque envoi et commentaire est examiné avant d’être visible.', sections: [{ title: 'Ce qui a sa place ici', text: 'Des histoires personnelles, des souvenirs, des réflexions et des conversations respectueuses. Tu peux utiliser ton nom, un pseudonyme ou publier anonymement.' }, { title: 'Ce que nous ne publions pas', text: 'Les insultes, menaces, le harcèlement, les discours de haine, la publicité, les liens suspects, le contenu sexuel impliquant des mineurs ou les informations privées d’autres personnes.' }, { title: 'Protège ta vie privée', text: 'Ne partage pas d’adresses, de numéros de téléphone, de mots de passe, de documents ni de données permettant d’identifier une autre personne. Tu peux demander à Loopi de modifier des noms, lieux ou détails avant la publication.' }, { title: 'Âge minimum', text: 'Tu dois avoir au moins 16 ans pour envoyer des histoires ou des commentaires. Si tu vois quelque chose d’inquiétant, n’interagis pas : signale-le via le formulaire concerné.' }] },
  pt: { title: 'Regras do Loopi', eyebrow: 'Comunidade segura', heading: 'Regras do Loopi', intro: 'O Loopi é um espaço para partilhar histórias com respeito. Todos os envios e comentários são revistos antes de ficarem visíveis.', sections: [{ title: 'O que tem lugar aqui', text: 'Histórias pessoais, memórias, reflexões e conversas respeitosas. Podes usar o teu nome, um pseudónimo ou publicar anonimamente.' }, { title: 'O que não publicamos', text: 'Insultos, ameaças, assédio, discurso de ódio, publicidade, ligações suspeitas, conteúdo sexual que envolva menores ou informação privada de outras pessoas.' }, { title: 'Protege a tua privacidade', text: 'Não partilhes moradas, números de telefone, palavras-passe, documentos ou dados que identifiquem outra pessoa. Podes pedir ao Loopi que altere nomes, lugares ou detalhes antes da publicação.' }, { title: 'Idade mínima', text: 'Tens de ter pelo menos 16 anos para enviar histórias ou comentários. Se vires algo preocupante, não interajas: denuncia-o através do formulário correspondente.' }] },
  it: { title: 'Regole di Loopi', eyebrow: 'Comunità sicura', heading: 'Regole di Loopi', intro: 'Loopi è uno spazio per condividere storie con rispetto. Ogni invio e commento viene revisionato prima di essere visibile.', sections: [{ title: 'Cosa trova spazio qui', text: 'Storie personali, ricordi, riflessioni e conversazioni rispettose. Puoi usare il tuo nome, uno pseudonimo o pubblicare in forma anonima.' }, { title: 'Cosa non pubblichiamo', text: 'Insulti, minacce, molestie, discorsi d’odio, pubblicità, link sospetti, contenuti sessuali che coinvolgono minori o informazioni private di altre persone.' }, { title: 'Proteggi la tua privacy', text: 'Non condividere indirizzi, numeri di telefono, password, documenti o dati che identificano un’altra persona. Puoi chiedere a Loopi di modificare nomi, luoghi o dettagli prima della pubblicazione.' }, { title: 'Età minima', text: 'Per inviare storie o commenti devi avere almeno 16 anni. Se vedi qualcosa di preoccupante, non interagire: segnalalo con l’apposito modulo.' }] },
  de: { title: 'Loopi-Regeln', eyebrow: 'Sichere Gemeinschaft', heading: 'Loopi-Regeln', intro: 'Loopi ist ein Ort, an dem Geschichten respektvoll geteilt werden. Jeder Beitrag und Kommentar wird geprüft, bevor er sichtbar wird.', sections: [{ title: 'Was hier Platz hat', text: 'Persönliche Geschichten, Erinnerungen, Gedanken und respektvolle Gespräche. Du kannst deinen Namen, ein Pseudonym verwenden oder anonym veröffentlichen.' }, { title: 'Was wir nicht veröffentlichen', text: 'Beleidigungen, Drohungen, Belästigung, Hassrede, Werbung, verdächtige Links, sexuelle Inhalte mit Minderjährigen oder private Informationen anderer Personen.' }, { title: 'Schütze deine Privatsphäre', text: 'Teile keine Adressen, Telefonnummern, Passwörter, Dokumente oder Daten, die eine andere Person identifizieren. Du kannst Loopi bitten, Namen, Orte oder Details vor der Veröffentlichung zu ändern.' }, { title: 'Mindestalter', text: 'Um Geschichten oder Kommentare einzureichen, musst du mindestens 16 Jahre alt sein. Wenn du etwas Beunruhigendes siehst, interagiere nicht damit: Melde es über das entsprechende Formular.' }] }
}[lang];
---
<BaseLayout lang={lang} title={copy.title} description={copy.intro}><section class="page-wrap text-page"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p class="intro">{copy.intro}</p><div class="rules">{copy.sections.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}</div></section></BaseLayout>
<style>.text-page{max-width:840px}.text-page h1{font:800 49px 'Plus Jakarta Sans';letter-spacing:-.07em;margin:8px 0}.intro{font-size:17px;color:var(--muted);max-width:700px}.rules{margin-top:35px}.rules section{padding:19px 0;border-top:1px solid var(--line)}.rules h2{font:800 21px 'Plus Jakarta Sans';letter-spacing:-.04em;margin:0}.rules p{color:var(--muted);font-size:14px;max-width:680px}</style>
