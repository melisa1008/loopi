---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages } from '../../lib/i18n';
import { categoriesForLanguage } from '../../lib/loopi';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const copy = {
  es: { title: 'Envía tu historia — Loopi', eyebrow: 'Tu voz importa', heading: 'Cuéntanos tu historia', intro: 'Puedes escribir con tu nombre, seudónimo o de forma anónima. Ninguna historia se publica sin revisión.', how: '¿Cómo funciona?', steps: [['Escribes', 'Comparte tu experiencia en texto.'], ['Eliges tu privacidad', 'Pide que cambiemos nombres o detalles identificables si lo necesitas.'], ['Revisamos', 'Loopi revisa cada envío con cuidado.'], ['Publicamos', 'Si se aprueba, aparece en la web al momento.']], before: 'Antes de enviar', form: 'El formulario te pedirá título, historia, categoría, idioma y cómo quieres que aparezca tu nombre.', choose: 'Elige entre', more: 'y más.', privacy: 'Puedes solicitar cambios de nombres, lugares y otros datos privados.', age: 'Debes tener 16 años o más y aceptar las normas.', open: 'Abrir el formulario seguro →', reminderTitle: 'Un espacio cuidado.', reminder: 'No aceptamos amenazas, insultos, datos personales de otras personas ni contenido que pueda poner a alguien en peligro.' },
  en: { title: 'Submit your story — Loopi', eyebrow: 'Your voice matters', heading: 'Tell us your story', intro: 'You can write using your name, a pseudonym, or anonymously. No story is published without review.', how: 'How does it work?', steps: [['You write', 'Share your experience in writing.'], ['You choose your privacy', 'Ask us to change names or identifying details if you need to.'], ['We review', 'Loopi reviews every submission with care.'], ['We publish', 'If it is approved, it appears on the website.']], before: 'Before you submit', form: 'The form will ask for a title, story, category, language, and how you want your name to appear.', choose: 'Choose from', privacy: 'You may request changes to names, places, and other private details.', age: 'You must be at least 16 and accept the rules.', open: 'Open the secure form →', reminderTitle: 'A cared-for space.', reminder: 'We do not accept threats, insults, other people’s personal data, or content that could put someone in danger.' },
  fr: { title: 'Envoyer ton histoire — Loopi', eyebrow: 'Ta voix compte', heading: 'Raconte-nous ton histoire', intro: 'Tu peux écrire avec ton nom, un pseudonyme ou anonymement. Aucune histoire n’est publiée sans examen.', how: 'Comment ça marche ?', steps: [['Tu écris', 'Partage ton expérience par écrit.'], ['Tu choisis ta confidentialité', 'Demande la modification de noms ou de détails identifiants si nécessaire.'], ['Nous examinons', 'Loopi examine chaque envoi avec soin.'], ['Nous publions', 'S’il est approuvé, il apparaît sur le site.']], before: 'Avant d’envoyer', form: 'Le formulaire demandera un titre, une histoire, une catégorie, une langue et la façon dont tu souhaites afficher ton nom.', choose: 'Choisis parmi', privacy: 'Tu peux demander des modifications de noms, lieux et autres données privées.', age: 'Tu dois avoir au moins 16 ans et accepter les règles.', open: 'Ouvrir le formulaire sécurisé →', reminderTitle: 'Un espace bienveillant.', reminder: 'Nous n’acceptons ni menaces, ni insultes, ni données personnelles d’autres personnes, ni contenu pouvant mettre quelqu’un en danger.' },
  pt: { title: 'Enviar a tua história — Loopi', eyebrow: 'A tua voz importa', heading: 'Conta-nos a tua história', intro: 'Podes escrever com o teu nome, um pseudónimo ou anonimamente. Nenhuma história é publicada sem revisão.', how: 'Como funciona?', steps: [['Escreves', 'Partilha a tua experiência por escrito.'], ['Escolhes a tua privacidade', 'Pede-nos para alterar nomes ou detalhes identificáveis, se precisares.'], ['Revemos', 'O Loopi revê cada envio com cuidado.'], ['Publicamos', 'Se for aprovado, aparece no site.']], before: 'Antes de enviar', form: 'O formulário pedirá título, história, categoria, idioma e como queres que o teu nome apareça.', choose: 'Escolhe entre', privacy: 'Podes pedir alterações a nomes, lugares e outros dados privados.', age: 'Tens de ter pelo menos 16 anos e aceitar as regras.', open: 'Abrir o formulário seguro →', reminderTitle: 'Um espaço cuidado.', reminder: 'Não aceitamos ameaças, insultos, dados pessoais de outras pessoas nem conteúdo que possa colocar alguém em perigo.' },
  it: { title: 'Invia la tua storia — Loopi', eyebrow: 'La tua voce conta', heading: 'Raccontaci la tua storia', intro: 'Puoi scrivere con il tuo nome, uno pseudonimo o in forma anonima. Nessuna storia viene pubblicata senza revisione.', how: 'Come funziona?', steps: [['Scrivi', 'Condividi la tua esperienza per iscritto.'], ['Scegli la tua privacy', 'Chiedi di modificare nomi o dettagli identificativi, se necessario.'], ['Esaminiamo', 'Loopi esamina ogni invio con cura.'], ['Pubblichiamo', 'Se approvato, appare sul sito.']], before: 'Prima di inviare', form: 'Il modulo chiederà titolo, storia, categoria, lingua e come desideri che appaia il tuo nome.', choose: 'Scegli tra', privacy: 'Puoi richiedere modifiche a nomi, luoghi e altri dati privati.', age: 'Devi avere almeno 16 anni e accettare le regole.', open: 'Apri il modulo sicuro →', reminderTitle: 'Uno spazio protetto.', reminder: 'Non accettiamo minacce, insulti, dati personali di altre persone o contenuti che potrebbero mettere qualcuno in pericolo.' },
  de: { title: 'Deine Geschichte senden — Loopi', eyebrow: 'Deine Stimme zählt', heading: 'Erzähl uns deine Geschichte', intro: 'Du kannst mit deinem Namen, einem Pseudonym oder anonym schreiben. Keine Geschichte wird ohne Prüfung veröffentlicht.', how: 'Wie funktioniert es?', steps: [['Du schreibst', 'Teile deine Erfahrung in einem Text.'], ['Du wählst deinen Datenschutz', 'Bitte uns bei Bedarf, Namen oder identifizierende Details zu ändern.'], ['Wir prüfen', 'Loopi prüft jede Einsendung sorgfältig.'], ['Wir veröffentlichen', 'Wenn sie genehmigt wird, erscheint sie auf der Website.']], before: 'Vor dem Senden', form: 'Das Formular fragt nach Titel, Geschichte, Kategorie, Sprache und danach, wie dein Name angezeigt werden soll.', choose: 'Wähle aus', privacy: 'Du kannst Änderungen von Namen, Orten und anderen privaten Details anfordern.', age: 'Du musst mindestens 16 Jahre alt sein und die Regeln akzeptieren.', open: 'Sicheres Formular öffnen →', reminderTitle: 'Ein geschützter Raum.', reminder: 'Wir akzeptieren keine Drohungen, Beleidigungen, persönlichen Daten anderer Personen oder Inhalte, die jemanden in Gefahr bringen könnten.' },
}[lang];
const categories = categoriesForLanguage(lang);
---
<BaseLayout lang={lang} title={copy.title} description={copy.intro}>
  <section class="page-wrap submit-page"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.heading}</h1><p class="intro">{copy.intro}</p>
  <div class="submit-grid"><div class="steps"><h2>{copy.how}</h2><ol>{copy.steps.map(([title, text]) => <li><b>{title}</b><span>{text}</span></li>)}</ol></div>
  <div class="form-card"><h2>{copy.before}</h2><p>{copy.form}</p><form id="story-form" data-language={lang}><label>Título<input name="title" required minlength="3" maxlength="160" /></label><label>Tu historia<textarea name="body" required minlength="20" maxlength="20000" rows="8"></textarea></label><label>Categoría<select name="category" required>{categories.map(item => <option value={item.id}>{item.label}</option>)}</select></label><label>Nombre o seudónimo <small>(opcional)</small><input name="author" maxlength="80" /></label><label>Correo para contactarte <small>(opcional, no se publica)</small><input name="email" type="email" maxlength="160" /></label><label>¿Qué detalles privados debemos cambiar? <small>(opcional)</small><textarea name="privacy" maxlength="1000" rows="3"></textarea></label><label class="check"><input name="anonymous" type="checkbox" /> Publicar de forma anónima</label><label class="check"><input name="age" type="checkbox" required /> Tengo al menos 16 años y acepto las normas.</label><button class="button" type="submit">Enviar para revisión →</button><p class="form-message" aria-live="polite"></p></form></div></div>
  <aside class="reminder"><b>{copy.reminderTitle}</b> {copy.reminder}</aside></section>
</BaseLayout>
<script>
  import { supabase, isSupabaseConfigured } from '../../lib/supabase';
  const form = document.querySelector<HTMLFormElement>('#story-form');
  const message = form?.querySelector<HTMLElement>('.form-message');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase || !isSupabaseConfigured || !message) { if (message) message.textContent = 'El formulario estará disponible cuando Loopi termine su configuración.'; return; }
    const data = new FormData(form);
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true; message.textContent = 'Enviando…';
    const { error } = await supabase.from('stories').insert({
      title: String(data.get('title')).trim(), body: String(data.get('body')).trim(),
      category: String(data.get('category')), language: form.dataset.language,
      author: data.get('anonymous') ? 'Anónimo' : (String(data.get('author')).trim() || 'Anónimo'),
      is_anonymous: Boolean(data.get('anonymous')), privacy_request: String(data.get('privacy')).trim() || null,
      contact_email: String(data.get('email')).trim() || null,
    });
    button.disabled = false;
    if (error) { message.textContent = 'No se pudo enviar. Comprueba tu conexión e inténtalo de nuevo.'; return; }
    form.reset(); message.textContent = '¡Gracias! Tu historia ha llegado a Loopi y será revisada antes de publicarse.';
  });
</script>
<style>.submit-page{max-width:980px}.submit-page h1{font:800 50px 'Plus Jakarta Sans';letter-spacing:-.07em;margin:7px 0}.intro{font-size:17px;max-width:610px;color:var(--muted)}.submit-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:20px;margin-top:35px}.steps,.form-card{border-radius:17px;padding:28px}.steps{background:var(--lilac)}.form-card{background:var(--surface);border:1px solid var(--line)}h2{font:800 23px 'Plus Jakarta Sans';letter-spacing:-.05em;margin:0 0 16px}.steps ol{list-style:none;margin:0;padding:0;counter-reset:steps}.steps li{display:grid;grid-template-columns:28px 1fr;column-gap:10px;margin:16px 0}.steps li:before{counter-increment:steps;content:counter(steps);grid-row:span 2;display:grid;place-items:center;width:23px;height:23px;border-radius:50%;background:var(--purple);color:#fff;font-size:11px;font-weight:800}.steps li b{font-size:13px}.steps li span,.form-card p{font-size:12px;color:var(--muted)}.steps li span{grid-column:2}.form-card form{display:grid;gap:12px}.form-card label{display:grid;gap:5px;font-size:12px;font-weight:700}.form-card small{font-weight:400;color:var(--muted)}.form-card input:not([type=checkbox]),.form-card textarea,.form-card select{width:100%;border:1px solid var(--line);border-radius:8px;background:var(--paper);padding:9px;color:var(--ink)}.form-card textarea{resize:vertical}.form-card .check{display:flex;align-items:center;gap:8px;font-weight:400}.form-card button{border:0;margin-top:4px}.form-message{min-height:18px;margin:0!important;color:var(--purple)!important}.reminder{margin-top:20px;border-left:3px solid var(--coral);padding:13px 16px;background:var(--surface)7f4;font-size:12px;color:#dfc4d0}.reminder b{display:block;margin-bottom:2px}@media(max-width:650px){.submit-page h1{font-size:38px}.submit-grid{grid-template-columns:1fr}}</style>
