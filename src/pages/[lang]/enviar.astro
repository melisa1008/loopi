---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages } from '../../lib/i18n';
import { categories, storyFormUrl } from '../../lib/loopi';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
---
<BaseLayout lang={lang} title="Envía tu historia — Loopi">
  <section class="page-wrap submit-page"><p class="eyebrow">Tu voz importa</p><h1>Cuéntanos tu historia</h1><p class="intro">Puedes escribir con tu nombre, seudónimo o de forma anónima. Ninguna historia se publica sin revisión.</p>
  <div class="submit-grid"><div class="steps"><h2>¿Cómo funciona?</h2><ol><li><b>Escribes</b><span>Comparte tu experiencia en texto.</span></li><li><b>Eliges tu privacidad</b><span>Pide que cambiemos nombres o detalles identificables si lo necesitas.</span></li><li><b>Revisamos</b><span>Loopi revisa cada envío con cuidado.</span></li><li><b>Publicamos</b><span>Si se aprueba, aparece en la web al momento.</span></li></ol></div>
  <div class="form-card"><h2>Antes de enviar</h2><p>El formulario te pedirá título, historia, categoría, idioma y cómo quieres que aparezca tu nombre.</p><ul><li>Elige entre: {categories.slice(0, 4).map(item => item.label).join(', ')} y más.</li><li>Puedes solicitar cambios de nombres, lugares y otros datos privados.</li><li>Debes tener 16 años o más y aceptar las normas.</li></ul>{storyFormUrl ? <a class="button" href={storyFormUrl} target="_blank" rel="noopener">Abrir el formulario seguro →</a> : <div class="setup-note"><b>Formulario en preparación</b><span>La recepción de historias se abrirá pronto. No publiques datos privados en sitios externos.</span></div>}</div></div>
  <aside class="reminder"><b>Un espacio cuidado.</b> No aceptamos amenazas, insultos, datos personales de otras personas ni contenido que pueda poner a alguien en peligro.</aside></section>
</BaseLayout>
<style>.submit-page{max-width:980px}.submit-page h1{font:800 50px 'Plus Jakarta Sans';letter-spacing:-.07em;margin:7px 0}.intro{font-size:17px;max-width:610px;color:var(--muted)}.submit-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:20px;margin-top:35px}.steps,.form-card{border-radius:17px;padding:28px}.steps{background:var(--lilac)}.form-card{background:var(--surface);border:1px solid var(--line)}h2{font:800 23px 'Plus Jakarta Sans';letter-spacing:-.05em;margin:0 0 16px}.steps ol{list-style:none;margin:0;padding:0;counter-reset:steps}.steps li{display:grid;grid-template-columns:28px 1fr;column-gap:10px;margin:16px 0}.steps li:before{counter-increment:steps;content:counter(steps);grid-row:span 2;display:grid;place-items:center;width:23px;height:23px;border-radius:50%;background:var(--purple);color:#fff;font-size:11px;font-weight:800}.steps li b{font-size:13px}.steps li span,.form-card p,.form-card li{font-size:12px;color:var(--muted)}.steps li span{grid-column:2}.form-card ul{padding-left:18px;line-height:1.7;margin:16px 0 21px}.setup-note{background:var(--lilac);border-radius:10px;padding:14px;font-size:12px;color:var(--muted)}.setup-note span{display:block;margin-top:2px}.reminder{margin-top:20px;border-left:3px solid var(--coral);padding:13px 16px;background:var(--surface)7f4;font-size:12px;color:#dfc4d0}.reminder b{display:block;margin-bottom:2px}@media(max-width:650px){.submit-page h1{font-size:38px}.submit-grid{grid-template-columns:1fr}}</style>
