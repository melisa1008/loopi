# Crea un proyecto en https://supabase.com y copia Settings > API.
# Estas dos claves pueden estar en la web pública: las reglas de seguridad de
# supabase/schema.sql son las que protegen los envíos y el panel privado.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=PEGA_AQUI_LA_CLAVE_ANON
